{
    "name": "vietnam-banks",
    "version": "1.0.0",
    "description": "Danh sách đầy đủ các ngân hàng tại Việt Nam kèm tên, SWIFT, website, loại hình — hỗ trợ TypeScript, tìm kiếm linh hoạt.",
    "keywords": [
        "vietnam",
        "bank",
        "banks",
        "ngan-hang",
        "swift",
        "bic",
        "vietcombank",
        "techcombank",
        "vietinbank",
        "vietnamese",
        "banking",
        "fintech",
        "typescript"
    ],
    "author": "Le Gia Nguyen (https://github.com/legianguyenit)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/legianguyenit/vietnam-banks.git"
    },
    "homepage": "https://github.com/legianguyenit/vietnam-banks#readme",
    "bugs": {
        "url": "https://github.com/legianguyenit/vietnam-banks/issues"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/legianguyenit"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "tsup": "^8.0.2",
        "typescript": "^5.4.0",
        "vitest": "^1.6.0"
    },
    "engines": {
        "node": ">=16"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}